# Response headers, read by Cloudflare Pages (and Netlify, same format).
# Nothing loads from another host (WebRTC to the PC is not governed by
# connect-src). Pages revalidate by default; the service worker must too.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), screen-wake-lock=(self), fullscreen=(self), microphone=(), geolocation=()

/sw.js
  Cache-Control: no-cache

# The help center as Markdown, for AI assistants (cmd/webapp/llms.go): in
# UTF-8 (arrows, quotes), as text that browsers show rather than download,
# readable by tools on other sites, and kept out of search results, where
# the articles' pages belong.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex
/help/*.md
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex
/help/ai-context.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

# The edit page talks to Resound on 127.0.0.1 and embeds the editor
# (audiocutter.online). Its own, narrower policy is in a <meta> tag
# (edit.html): it can't reach this host at all. Two policies would both
# apply, so the site-wide one is dropped here; X-Frame-Options takes over
# frame-ancestors, which a <meta> policy can't set.
/edit
  ! Content-Security-Policy
  X-Frame-Options: DENY
/edit.html
  ! Content-Security-Policy
  X-Frame-Options: DENY
